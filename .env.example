# Supabase - copie para .env.local e preencha com as chaves do seu projeto
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# URL pública do site (usada no QR code e no portal do cliente da OS)
# Em produção, use o domínio da Vercel, ex.: https://sistemaservitecpoa.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (notificações PWA para técnicos)
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@servitecpoa.com.br

# Service role (necessária para enviar push ao técnico quando admin cria OS)
# Supabase → Settings → API → service_role (NUNCA exponha no front-end)
SUPABASE_SERVICE_ROLE_KEY=

# Dados da empresa (aparecem no cabeçalho da OS em PDF)
NEXT_PUBLIC_EMPRESA_NOME="ServitecPoa Assistência Técnica"
NEXT_PUBLIC_EMPRESA_CNPJ="00.000.000/0001-00"
NEXT_PUBLIC_EMPRESA_TELEFONE="(51) 00000-0000"
NEXT_PUBLIC_EMPRESA_EMAIL="contato@servitecpoa.com.br"
NEXT_PUBLIC_EMPRESA_ENDERECO="Rua Exemplo, 123 - Porto Alegre/RS"
